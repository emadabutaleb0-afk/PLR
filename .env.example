# ---- Security (change these before real use) ----
SECRET_KEY=replace-with-32-or-more-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=240
# First CEO account, created automatically on the first start (only when there are no users yet)
BOOTSTRAP_ADMIN_EMAIL=ceo@company.local
BOOTSTRAP_ADMIN_PASSWORD="change-this-first-password"
# ---- Data rules ----
STALE_DATA_DAYS=45
# Load the company CSVs automatically the first time the app starts with an empty database
AUTO_IMPORT_ON_START=true
# Used only by docker compose (Postgres)
POSTGRES_PASSWORD=change-me
# NOTE: DATABASE_URL / REDIS_URL / DATA_DIRECTORY are intentionally NOT set here.
# Local run -> SQLite file in backend/ and CSVs in data/private (auto-detected). docker compose sets them itself.

# Discount depth above this (Retail/Online) is counted as discount leakage
DISCOUNT_COMFORT_PCT=0.10

# ---- V4 decision plans (optional) ----
# Cash cap on replenishment spend inside a decision plan. Leave empty = unconstrained (the real company figure is unknown).
# DECISION_BUDGET_EGP=250000
# How many actions one department can absorb per plan (an assumption: confirm with management)
MAX_ACTIONS_PER_DEPARTMENT=8
